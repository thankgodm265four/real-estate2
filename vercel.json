{
    "version": 2,
    "builds": [
        {
            "src": "*.php",
            "use": "vercel-php@0.6.0"
        },
        {
            "src": "admin/*.php",
            "use": "vercel-php@0.6.0"
        },
        {
            "src": "admin/includes/*.php",
            "use": "vercel-php@0.6.0"
        },
        {
            "src": "sections/*.php",
            "use": "vercel-php@0.6.0"
        },
        {
            "src": "includes/*.php",
            "use": "vercel-php@0.6.0"
        },
        {
            "src": "config/*.php",
            "use": "vercel-php@0.6.0"
        }
    ],
    "routes": [
        {
            "src": "/(.*)\\.php",
            "dest": "/$1.php"
        },
        {
            "src": "/admin/(.*)",
            "dest": "/admin/$1"
        },
        {
            "src": "/assets/(.*)",
            "dest": "/assets/$1"
        },
        {
            "src": "/sections/(.*)",
            "dest": "/sections/$1"
        },
        {
            "src": "/",
            "dest": "/index.php"
        }
    ],
    "env": {
        "PHP_VERSION": "8.2"
    }
}